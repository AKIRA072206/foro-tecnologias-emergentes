Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Servir archivos y directorios existentes tal cual
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Enviar todo al front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Bloquear acceso a archivos sensibles si se exponen
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>
