<%
  const est = locals.estudiante;
  const nombreCompleto = locals.nombreCompleto;
  const archivoPdf = locals.archivoPdf;

  // Tipo de certificado: "asistencia" (por defecto) o "reconocimiento".
  const tipo = locals.tipoCertificado === "reconocimiento" ? "reconocimiento" : "asistencia";
  const esAsistencia = tipo === "asistencia";

  const titulo = esAsistencia ? "CERTIFICADO" : "RECONOCIMIENTO";
  const introMotivo = esAsistencia
    ? "Por haber asistido al"
    : "Por su valiosa participación en el";

  const cedulaRaw = String(est.cedula ?? "").replace(/\D+/g, "");
  const cedulaFmt = cedulaRaw ? `V - ${cedulaRaw.replace(/\B(?=(\d{3})+(?!\d))/g, ".")}` : "";

  const partesEvento = String(locals.eventoTitulo ?? "").split(":");
  const eventoLinea1 = (partesEvento[0] ?? "").trim();
  const eventoLinea2 = partesEvento.slice(1).join(":").trim();
%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= esAsistencia ? "Certificado de Asistencia" : "Reconocimiento" %> — <%= nombreCompleto %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/certificado.css">
</head>
<body class="cert-page">
    <div class="cert-toolbar no-print">
        <a href="<%= locals.volverHref %>" class="btn-tool">← Volver</a>
        <div class="cert-toolbar-actions">
            <span class="cert-save-status" id="pdf-estado" role="status" aria-live="polite"></span>
            <button type="button" class="btn-tool" id="btn-imprimir">Imprimir</button>
            <button type="button" class="btn-tool btn-tool-primary" id="btn-descargar-pdf">Descargar PDF</button>
        </div>
    </div>

    <article class="certificate" id="certificado" aria-label="<%= esAsistencia ? 'Certificado de asistencia' : 'Reconocimiento' %>"
             data-filename="<%= archivoPdf %>"
             data-estudiante-id="<%= est.id %>"
             data-csrf="<%= locals.csrf || '' %>">
        <img class="cert-bg" src="/img/plantilla-certificado-limpia.png" alt="" aria-hidden="true">

        <div class="cert-content">
            <header class="cert-top">
                <h1 class="cert-title"><%= titulo %></h1>

                <div class="cert-divider" aria-hidden="true"><span></span></div>

                <p class="cert-otorgado">Otorgado a</p>

                <p class="cert-name"><%= nombreCompleto %></p>

                <% if (cedulaFmt) { %>
                <p class="cert-cedula"><%= cedulaFmt %></p>
                <% } %>

                <div class="cert-divider cert-divider-name" aria-hidden="true"><span></span></div>
            </header>

            <section class="cert-body">
                <p class="cert-motivo">
                    <span class="cert-motivo-intro"><%= introMotivo %></span>
                    <strong class="cert-motivo-evento">
                        <%= eventoLinea1 %><% if (eventoLinea2) { %>:<br><%= eventoLinea2 %><% } %>
                    </strong>
                </p>

                <p class="cert-colaboracion">
                    Realizado en colaboración con los estudiantes de trayecto IV<br>
                    y sus formadoras Dra. Noraima Merlo e Ing. Lidia Cordero<br>
                    del Programa Nacional de Formación en Informática<br>
                    de la UPTYAB.
                </p>
            </section>

            <footer class="cert-bottom">
                <% if (esAsistencia) { %>
                <div class="cert-signatures">
                    <div class="cert-sign">
                        <span class="cert-sign-line" aria-hidden="true"></span>
                        <p class="cert-sign-name">Dra. Noraima Merlo</p>
                        <p class="cert-sign-role">Prof. Formadora PST<br>IV</p>
                    </div>
                    <div class="cert-sign">
                        <span class="cert-sign-line" aria-hidden="true"></span>
                        <p class="cert-sign-name">Ing. Roberth Mujica</p>
                        <p class="cert-sign-role">Tutor Asesor</p>
                    </div>
                    <div class="cert-sign">
                        <span class="cert-sign-line" aria-hidden="true"></span>
                        <p class="cert-sign-name">MSc. Luis Cordero</p>
                        <p class="cert-sign-role">Coord. de PNF en Informática</p>
                    </div>
                </div>
                <% } %>

                <p class="cert-fecha"><%= locals.eventoFecha %></p>

                <div class="cert-divider cert-divider-bottom" aria-hidden="true"><span></span></div>
            </footer>
        </div>
    </article>

    <script src="https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js"></script>
    <script src="/js/certificado.js"></script>
</body>
</html>
