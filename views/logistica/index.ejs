<%
  const estudiantes = locals.estudiantes ?? [];
  const error = locals.error ?? null;
  const habilitada = Boolean(locals.asistenciaHabilitada);
  const total = estudiantes.length;
  const asistentes = estudiantes.filter((e) => Boolean(e.asistio)).length;
  const colspan = habilitada ? 9 : 8;
  const fmt = (value) => {
    if (!value) return "—";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "—";
    const pad = (n) => String(n).padStart(2, "0");
    return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };
%>
<%- include("../layouts/header") %>
<section class="section py-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
            <div>
                <h1 class="h3 mb-1">Panel de logística</h1>
                <p class="text-muted mb-0">
                    Evento: <%= locals.eventoFecha %> · <%= locals.eventoHora %>
                    · Sesión: <strong><%= locals.usuario ?? "" %></strong>
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="badge text-bg-primary fs-6"><span id="stat-total"><%= total %></span> registrados</span>
                <% if (habilitada) { %>
                    <span class="badge text-bg-success fs-6"><span id="stat-asistentes"><%= asistentes %></span> asistieron</span>
                <% } %>
                <a class="btn btn-outline-primary btn-sm" href="/logout">Cerrar sesión</a>
            </div>
        </div>

        <% if (habilitada) { %>
            <div class="alert alert-success" role="status">
                Modo prueba activo: use el selector <strong>¿Vino?</strong> para marcar asistencia y generar certificados.
            </div>
        <% } else { %>
            <div class="alert alert-info" role="status">
                Listado de inscritos en vivo. El control de asistencia se habilitará el <strong>06 de noviembre de 2026</strong>.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="flex-grow-1" style="max-width: 360px;">
                <label class="visually-hidden" for="buscador">Buscar</label>
                <input type="search" class="form-control" id="buscador"
                       placeholder="Buscar por cédula, nombre o institución…" autocomplete="off">
            </div>
            <p class="text-muted small mb-0" id="refresh-note">
                <%= locals.realtime ? "Actualización en vivo (Neon Realtime)" : "Actualización automática cada 15 s" %>
            </p>
        </div>

        <div class="filtro-procedencia mb-3" role="group" aria-label="Filtrar por procedencia">
            <button type="button" class="filtro-btn is-active" data-tipo="todos">Todos</button>
            <button type="button" class="filtro-btn" data-tipo="universidad">Universidad</button>
            <button type="button" class="filtro-btn" data-tipo="empresa">Empresa</button>
            <button type="button" class="filtro-btn" data-tipo="otra">Otra</button>
            <button type="button" class="filtro-btn" data-tipo="no_indico">Sin institución</button>
        </div>

        <div class="table-responsive card shadow-sm border-0">
            <table class="table table-hover table-striped align-middle mb-0" id="tabla-asistencia"
                   data-asistencia="<%= habilitada ? "1" : "0" %>"
                   data-live="<%= locals.realtime ? "1" : "0" %>">
                <thead class="table-primary">
                    <tr>
                        <th>Cédula</th>
                        <th>Apellido</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Institución</th>
                        <% if (habilitada) { %>
                            <th>¿Vino?</th>
                            <th>Certificado</th>
                        <% } else { %>
                            <th>Registro</th>
                        <% } %>
                        <th>Acciones</th>
                    </tr>

                </thead>
                <tbody id="tbody-estudiantes">
                <% if (estudiantes.length === 0) { %>
                    <tr class="empty-row">
                        <td colspan="<%= colspan %>" class="text-center text-muted py-4">No hay participantes registrados aún.</td>
                    </tr>
                <% } else { %>
                    <% estudiantes.forEach((est) => { const asistio = Boolean(est.asistio); const id = Number(est.id); %>
                        <tr data-id="<%= id %>"
                            data-cedula="<%= String(est.cedula).toLowerCase() %>"
                            data-apellido="<%= String(est.apellido).toLocaleLowerCase("es") %>"
                            data-tipo="<%= est.institution_type ?? "no_indico" %>">
                            <td><%= est.cedula %></td>
                            <td><%= est.apellido %></td>
                            <td><%= est.nombre %></td>
                            <td><%= est.correo %></td>
                            <td><%= est.telefono %></td>
                            <td class="cell-inst">
                                <% if ((est.institution_type ?? "no_indico") === "no_indico") { %>
                                    <span class="text-muted">—</span>
                                <% } else { %>
                                    <span class="inst-nombre"><%= est.institution_name %></span>
                                    <span class="inst-tipo"><%= est.institution_type %></span>
                                <% } %>
                            </td>
                            <% if (habilitada) { %>
                                <td>
                                    <% if (asistio) { %>
                                        <select class="form-select form-select-sm select-asistencia" data-id="<%= id %>" disabled
                                                title="Asistencia confirmada: no se puede modificar"
                                                aria-label="Asistencia confirmada de <%= est.nombre %> <%= est.apellido %>">
                                            <option value="1" selected>Sí</option>
                                        </select>
                                    <% } else { %>
                                        <select class="form-select form-select-sm select-asistencia" data-id="<%= id %>"
                                                aria-label="Asistencia de <%= est.nombre %> <%= est.apellido %>">
                                            <option value="0" selected>No</option>
                                            <option value="1">Sí</option>
                                        </select>
                                    <% } %>
                                </td>
                                <td class="cell-cert">
                                    <% if (asistio) { %>
                                        <a class="btn btn-sm btn-outline-primary" href="/certificados/<%= id %>" target="_blank" rel="noopener">Ver</a>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </td>
                            <% } else { %>
                                <td><%= fmt(est.fecha_registro) %></td>
                            <% } %>
                            <td class="cell-acciones">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-eliminar"
                                        data-id="<%= id %>"
                                        data-nombre="<%= est.nombre %> <%= est.apellido %>"
                                        data-eliminar="0"
                                        title="Eliminar registro">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
                </tbody>
            </table>
        </div>

        <input type="hidden" id="csrf-logistica" value="<%= csrf %>">
        <p id="toast-logistica" class="toast" role="status" aria-live="polite"></p>
    </div>
</section>

<div class="confirm-modal" id="confirm-modal" hidden aria-hidden="true">
    <div class="confirm-modal-card" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <h2 class="h5 mb-2" id="confirm-title">Eliminar registro</h2>
        <p class="text-muted mb-4" id="confirm-text">
            ¿Seguro que desea eliminar este participante? La acción no se puede deshacer.
        </p>
        <div class="confirm-modal-actions">
            <button type="button" class="btn btn-outline-secondary" id="confirm-cancel">Cancelar</button>
            <button type="button" class="btn btn-danger" id="confirm-delete">Sí, eliminar</button>
        </div>
    </div>
</div>

<%- include("../layouts/footer") %>
